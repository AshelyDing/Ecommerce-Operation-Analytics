# ============================================================
# Ecommerce-Operation-Analytics 项目忽略规则
# 保留: *.py / *.sql / *.md / .gitignore
# 不提交: 仿真与结果数据 (可随时由脚本再生成)
# ============================================================

# ------------------------------------------------------------
# Python 相关
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# 虚拟环境目录
.venv/
venv/
env/
ENV/
.env

# ------------------------------------------------------------
# 数据文件 (data/ 下所有内容均不提交: 原始仿真数据 + 分析结果)
# 原始数据由 python/data_generator.py 一键生成, 无需入库
# 结果数据由 SQL / Python 分析脚本输出, 可直接本地再生成
# ------------------------------------------------------------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# 数据库文件 (如快速开始的 SQLite 示例库)
*.db
*.sqlite
*.sqlite3

# 表格/图片等数据类文件 (若散落在 data/ 之外也一并忽略)
*.csv
*.xlsx
*.xls
*.parquet
*.jsonl

# ------------------------------------------------------------
# Power BI 相关 (看板源文件不入库, 仅保留 screenshots 预览截图)
# ------------------------------------------------------------
*.pbix
*.pbit
*.pbix~
*.pbit~
~$*

# ------------------------------------------------------------
# IDE / 编辑器相关
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------
# 系统文件
# ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
*.log

# ------------------------------------------------------------
# 临时文件
# ------------------------------------------------------------
*.tmp
*.temp
*.bak

# 临时校验/调试脚本 (如 _validate_sql.py, 用完即删, 不入库)
_validate_*.py
_tmp_*.py
tmp_*.py
